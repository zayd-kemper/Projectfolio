# ============================================
# ProjectFolio Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/projectfolio
# Optional owner credential used only by `npm run db:retry-warnings` during legacy upgrades.
# MIGRATION_DATABASE_URL=postgresql://owner:password@localhost:5432/projectfolio
# OR individual values:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectfolio
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_MAX_WEB=8
DB_POOL_MAX_WORKER=4
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_WEB_MS=5000
DB_STATEMENT_TIMEOUT_WORKER_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_SLOW_QUERY_MS=200

# Redis backs distributed rate limits, quotas, cache, and jobs; Supabase owns Auth sessions.
# Required in production. Leave empty for a limited local setup without Redis.
REDIS_URL=redis://localhost:6379

# ── Supabase Auth ───────────────────────────────────────────────────
# Supabase Auth (GoTrue) is the identity provider and token issuer. The API only
# VERIFIES tokens, using the project's public JWKS — there is no shared signing
# secret to configure and nothing to rotate here when Supabase rotates its keys.
# Project Settings -> API. All three are required in production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# Service role key: full admin, bypasses RLS. Server-side only, never shipped to
# the browser. Used to mint the AI agent verifier's login link. Without it, agent
# browser verification degrades to public routes only.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary (for image/video storage) - get these from cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google / GitHub / LinkedIn OAuth credentials now live in the Supabase dashboard
# (Authentication -> Providers), not here. Each provider's own console must allow
# https://<project-ref>.supabase.co/auth/v1/callback as a redirect URI.

# Email (for sending portfolio share emails)
# For Gmail: use an App Password (not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=ProjectFolio <your_email@gmail.com>

# Frontend URL (where your React app runs)
FRONTEND_URL=http://localhost:3000

# App URL (where your backend API runs - needed for PDF export)
APP_URL=http://localhost:5000

# Dedicated origin that serves executable user custom-site code (HTML/CSS/JS).
# Must be a DISTINCT registrable host from the app (needs its own DNS + TLS) so
# author JS never runs on the app's credentialed origin. Leave unset in dev to
# fall back to same-origin serving. Frontend must set VITE_CUSTOM_SITE_ORIGIN to match.
# CUSTOM_SITE_SANDBOX_ORIGIN=https://usercontent.example.com

# Runtime and observability
LOG_LEVEL=info
METRICS_TOKEN=replace_with_a_private_metrics_token
MIGRATION_WARNINGS_FATAL=true
PROCESS_ROLE=web
PUBLIC_CACHE_TTL_SECONDS=60
# Days of discover_events history to keep. Floored at 15 in code: the Discover
# recommendation scoring looks back 14 days.
DISCOVER_EVENT_RETENTION_DAYS=30
JOB_RESULT_TTL_DAYS=7
# Required in production. Previously fell back to JWT_SECRET, which no longer exists.
ANALYTICS_VISITOR_SECRET=replace_with_an_independent_random_secret
WORKER_CONCURRENCY=4
MAINTENANCE_INTERVAL_MS=3600000
REVISION_RETENTION_DAYS=90

# AI Providers
# Groq is the only enabled provider by default.
GROQ_API_KEY=your_groq_api_key
GROQ_PROVIDER_TIMEOUT_MS=75000

# NVIDIA NIM/OpenAI-compatible models. Enable this when you want GPT-OSS 20B
# available as a coding model through your NVIDIA API key.
ENABLE_NVIDIA_MODELS=false
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PROVIDER_TIMEOUT_MS=150000
NVIDIA_GPT_OSS_TIMEOUT_MS=150000
NVIDIA_GPT_OSS_20B_MODEL=openai/gpt-oss-20b
NVIDIA_GPT_OSS_JSON_MODE=false

# OpenRouter can run the premium/experimental model choices through one key.
# When enabled, ProjectFolio routes large UI tasks toward Qwen/Nemotron and
# mid-sized UI tasks toward Qwen/Nemotron first, then Poolside/Nex. Leave disabled
# until you want OpenRouter routing active in the app.
ENABLE_OPENROUTER_MODELS=false
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ProjectFolio
OPENROUTER_PROVIDER_TIMEOUT_MS=150000
OPENROUTER_QWEN_TIMEOUT_MS=150000
OPENROUTER_NEMOTRON_TIMEOUT_MS=150000
OPENROUTER_LAGUNA_TIMEOUT_MS=150000
OPENROUTER_NEX_TIMEOUT_MS=220000
AI_PROVIDER_TIMEOUT_MS=120000

# Frontend timeout knobs live in frontend/.env, not this backend .env file:
# VITE_API_TIMEOUT_MS=30000
# VITE_AGENT_API_TIMEOUT_MS=300000

# Optional OpenRouter slug overrides. Defaults are:
# qwen/qwen3-coder
# nvidia/nemotron-3-super-120b-a12b
# poolside/laguna-m.1
# nex-agi/nex-n2-pro:free
OPENROUTER_QWEN_CODER_MODEL=qwen/qwen3-coder
OPENROUTER_NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_POOLSIDE_LAGUNA_MODEL=poolside/laguna-m.1
OPENROUTER_NEX_N2_PRO_MODEL=nex-agi/nex-n2-pro:free

# OpenRouter providers differ on strict JSON response_format support.
# Leave these off unless you confirm the selected endpoint supports json_object.
OPENROUTER_QWEN_JSON_MODE=false
OPENROUTER_NEMOTRON_JSON_MODE=false
OPENROUTER_LAGUNA_JSON_MODE=false
OPENROUTER_NEX_JSON_MODE=false

# By default, failed browser-verification bundles are discarded instead of
# appearing as pending but unusable review bundles.
AGENT_KEEP_FAILED_REVIEW_BUNDLES=false
