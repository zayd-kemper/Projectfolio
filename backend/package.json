    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mdast-util-to-string": "^4.0.0",
    "nodemailer": "^9.0.1",
    "openid-client": "^6.8.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-openidconnect": "^0.1.2",
    "pg": "^8.11.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^22.0.0",
    "rate-limit-redis": "^4.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sanitize-html": "^2.13.0",
    "unified": "^11.0.5"
