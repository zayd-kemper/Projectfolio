{
  "name": "projectfolio-backend",
  "version": "1.0.0",
  "description": "ProjectFolio API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node config/runMigrations.js",
    "db:retry-warnings": "node scripts/retryMigrationWarnings.js",
    "db:migrate:legacy": "node config/migrate.js",
    "db:seed": "node config/seed.js",
    "db:seed:test-portfolio": "node scripts/seedTestPortfolio.js",
    "worker": "node worker.js",
    "verify:scalability": "node scripts/verifyScalability.js",
    "test:load": "node scripts/loadSmoke.js",
    "test:security-smoke": "node scripts/securityAuditSmoke.js",
    "test:sandbox-smoke": "node scripts/customSiteSandboxSmoke.js",
    "test": "node --test test/databaseDateParser.test.js test/githubImport.test.js test/importRoute.test.js test/safeFetch.test.js test/applicationPlatforms.test.js test/profileExperiences.test.js test/applicationContext.test.js test/resumeRenderer.test.js test/coverLetter.test.js test/applicationPackage.test.js test/applicationsRoute.test.js test/agentBrowserVerifier.test.js test/agentRoute.test.js test/aiCustomizer.test.js test/aiModels.test.js test/customSiteSecurity.test.js test/frontendMotionArchitecture.test.js test/integrationsAiParsing.test.js test/layeredCustomization.test.js test/portfolioAiContext.test.js test/siteAgent.test.js test/siteAgentPlanner.test.js test/scalability.test.js",
    "test:agent-browser": "node --test test/agentBrowserVerifier.browser.test.js",
    "verify:agent-live": "node scripts/verifyAgentLiveRoutes.js",
    "verify:agent-quality": "node scripts/verifyAgentQualityGate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "cloudinary": "^2.9.0",
