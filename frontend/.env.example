# API routing
# /api uses Vite's localhost:5000 development proxy. For a separately hosted API,
# set its public /api URL before the production build.
VITE_API_URL=/api
# VITE_API_PROXY_TARGET=http://localhost:5000

# Frontend request timeouts
# Normal API calls stay short; Site Agent calls need longer because model generation
# plus browser verification can exceed 30 seconds.
VITE_API_TIMEOUT_MS=30000
VITE_AGENT_API_TIMEOUT_MS=300000

# Origin that serves executable user custom-site code. Must match the backend's
# CUSTOM_SITE_SANDBOX_ORIGIN — a distinct host from the app so custom-site JS is
# framed from a separate origin. Leave unset in dev for same-origin serving.
# VITE_CUSTOM_SITE_ORIGIN=https://usercontent.example.com

# ── Supabase Auth ───────────────────────────────────────────────────
# Must point at the same project as the backend's SUPABASE_URL. The publishable
# (anon) key is public by design and is meant to ship in the bundle — never put
# the service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
